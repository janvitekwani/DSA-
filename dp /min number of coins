
 // RECURSION ANS MEMORISAATION


class Solution {

    
    
      int solveMen (int[] coins , int amount , int [] dp)
      {
          //base case
         if(amount ==0) return 0;

         if(amount <0)  return Integer.MAX_VALUE;

         if(dp[amount] !=-1){
            return dp[amount];
         }

         int mini = Integer.MAX_VALUE;
          for(int i=0;i<coins.length;i++) {
             int ans = solveMen(coins ,amount- coins[i], dp) ;
             if(ans != Integer.MAX_VALUE) {
                 mini = Math.min(mini,1+ans);
           
             }

             }
             //dp[amount] = mini;
             return mini; 
      }

    public int coinChange(int[] coins, int amount) {
        // int ans =  solveUsingRecursion( coins ,  amount);
        // if(ans == Integer.MAX_VALUE)  return -1;
         
        //   return ans;

        int [] dp = new int[amount+1];

        for(int i=0;i<=amount ;i++)
        {
             dp[i]=-1;
        }

        int ans = solveMen(coins,amount, dp);

    

        if(ans == Integer.MAX_VALUE)  return -1;
         
          return ans;
    }
}



// TABULATION CODE 


class Solution {
    int solvetab(int[] coins, int amount) {
        int[] dp = new int[amount + 1];
        for (int i = 0; i <= amount; i++) {
            dp[i] = Integer.MAX_VALUE;
        }
        dp[0] = 0;

        for (int i = 1; i <= amount; i++) {
            int mini = Integer.MAX_VALUE;  // Declare mini for each i
            for (int j = 0; j < coins.length; j++) {
                if (i - coins[j] >= 0 && dp[i - coins[j]] != Integer.MAX_VALUE) {
                    int ans = dp[i - coins[j]];
                    if (ans != Integer.MAX_VALUE) {
                        mini = Math.min(mini, 1 + ans);
                    }
                }
            }
            dp[i] = mini;  // Update dp[i] with the minimum coins needed for i
        }

        return dp[amount];
    }

    public int coinChange(int[] coins, int amount) {
        int ans = solvetab(coins, amount);

        if (ans == Integer.MAX_VALUE) return -1;

        return ans;
    }
}


