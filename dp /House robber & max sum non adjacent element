
// TABULATION 



int solveTab (int nums[] )
    {
        
        int n = nums.length;
          int [] dp = new int[nums.length];
        

         
         dp[0] = nums[0];
         
           // For the second element, you either pick it or not
               dp[1] = Math.max(nums[0], nums[1]);
         
         for (int i=1;i<n;i++)
         {    if(i-1>=0 && i-2>=0)
              {int incl = dp[i-2]+nums[i];
              int excl = dp[i-1]+0;
              dp[i]= Math.max(incl, excl);
              }
         }
          
         
         return dp[n-1]; 
        
    }
    
    int findMaxSum(int nums[]) {
