// RECURSION AND MEMORISATION

 int solve(int nums[] , int n , int dp[])
    {
        // base case
        if(n<0) 
         return 0;
        
        if(n==0)
           return nums[0];
           
             if (dp[n]!=-1)
             {
                  return dp[n];
             }
           
           int incl = solve(nums, n-2 , dp)+nums[n];
           
           int excl = solve(nums, n-1 , dp)+0;
           
           dp[n]= Math.max(incl, excl);
           
           return dp[n];
           
        
    }


// SPACE OPTIMISATION 


class Solution {

   
    public int rob(int[] nums) {

        if(nums.length==1)  return nums[0];

       int   prev1 = nums[0];
int  prev2 = 0;
  
       for (int i=1;i<nums.length;i++)
       {
           
         int incl = prev2 + nums[i];
           int excl = prev1+0; 

        int ans = Math.max(incl, excl);
          prev2 = prev1;
          prev1 = ans;
          
     }

      
    


       return prev1;
        
    }
}
